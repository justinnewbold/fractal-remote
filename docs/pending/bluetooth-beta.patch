+                    {ways.pcChannel}
+                  </Text>
+                  <Press
+                    label="+"
+                    accessibilityLabel="One higher"
+                    height={44}
+                    style={{ paddingHorizontal: space.lg }}
+                    disabled={ways.pcChannel >= 16}
