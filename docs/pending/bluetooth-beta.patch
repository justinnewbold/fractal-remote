+    const walk = (dir) => {
+      for (const entry of readdirSync(fileURLToPath(dir))) {
+        const full = fileURLToPath(new URL(entry, dir))
+        if (statSync(full).isDirectory()) walk(new URL(`${entry}/`, dir))
