+        if (am4) return null
+        if (part.length === 3 && part[2] === 'summary') {
+          return async () => ({ number: n, name: last.name, scenes: await gen3SceneNames(n) })
+        }
+        if (part.length === 3 && part[2] === 'scenes') return async () => ({ number: n, names: await gen3SceneNames(n) })
+      }
+      return null
+    }
