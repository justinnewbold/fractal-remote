{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/iphone",
      "destination": "https://apps.apple.com/app/id6812916461",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/android",
      "destination": "/android.html"
    },
    {
      "source": "/downloads",
      "destination": "/downloads.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/notices",
      "destination": "/notices.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
