<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Merged into the app's own manifest at build time. These live here rather
    than in app.json because app.json's android.permissions is a plain list of
    names and cannot carry maxSdkVersion or usesPermissionFlags.

    required="false" on both features: a phone without MIDI or Bluetooth LE
    still gets the app from the Play store; it simply never shows the
    Bluetooth page (supported() says no).
  -->
  <uses-feature android:name="android.software.midi" android:required="false"/>
  <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>

  <!--
    And the two that the older permissions below imply, though nothing here
    says them. Google Play reads a hardware permission as "this app needs that
    hardware" and hides the app, and its updates, from any device without it,
    unless the feature is declared required="false". Android's own table of
    implied features (developer.android.com/guide/topics/manifest/uses-feature-element,
    "Permissions that imply feature requirements"): BLUETOOTH and
    BLUETOOTH_ADMIN imply android.hardware.bluetooth, ACCESS_FINE_LOCATION
    implies android.hardware.location. The build tool that reads the manifest
    for Play adds them whatever maxSdkVersion says, so "Android 11 and older"
    below does not keep them away from newer devices. BLUETOOTH_SCAN and
    BLUETOOTH_CONNECT imply nothing.
  -->
  <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>
  <uses-feature android:name="android.hardware.location" android:required="false"/>

  <!-- Android 11 and older: scanning for an adapter needs these, location included. -->
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>

  <!-- Android 12 and newer: scan and connect, and the scan is never used to work out where the phone is. -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
</manifest>
